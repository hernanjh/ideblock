{
  "name": "@ideblock/desktop",
  "productName": "IdeBlock",
  "version": "0.1.0",
  "private": true,
  "description": "Open source IDE for programming Arduino-compatible and ESP32 boards with blocks or code",
  "license": "GPL-3.0-only",
  "author": "Hernan Hegykozi <hernanjh@gmail.com>",
  "homepage": "https://github.com/hernanjh/ideblock",
  "repository": {
    "type": "git",
    "url": "https://github.com/hernanjh/ideblock.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "node ../../scripts/fetch-arduino-cli.mjs && electron-vite build && electron-builder --publish never",
    "package:dir": "node ../../scripts/fetch-arduino-cli.mjs && electron-vite build && electron-builder --dir --publish never",
    "package:offline": "node ../../scripts/fetch-arduino-cli.mjs && node ../../scripts/stage-offline-pack.mjs && electron-vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "electron-vite build && playwright test"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@ideblock/blocks": "0.0.0",
    "@ideblock/boards": "0.0.0",
    "@ideblock/code-to-blocks": "0.0.0",
    "@ideblock/i18n": "0.0.0",
    "@ideblock/shared": "0.0.0",
    "@ideblock/simulator": "0.0.0",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wokwi/elements": "1.9.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "i18next": "27.1.5",
    "lucide-react": "1.75.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "uplot": "1.6.32",
    "vite": "8.3.8",
    "zustand": "5.1.0"
  }
}
