diff --git a/hw/misc/esp32_ledc.c b/hw/misc/esp32_ledc.c
index 773d44e..55409a8 100644
--- a/hw/misc/esp32_ledc.c
+++ b/hw/misc/esp32_ledc.c
@@ -34,6 +34,15 @@ static uint64_t esp32_ledc_read(void *opaque, hwaddr addr, unsigned int size)
     case A_LEDC_LSCH7_CONF0_REG:
         r = s->channel_conf0_reg[(addr - A_LEDC_HSCH0_CONF0_REG) / 0x14];
         break;
+    default:
+        /* IdeBlock: DUTY (0x08) and DUTY_R (0x10) readback per channel */
+        if (addr >= A_LEDC_HSCH0_CONF0_REG && addr < A_LEDC_HSCH0_CONF0_REG + 16 * 0x14) {
+            int off = (addr - A_LEDC_HSCH0_CONF0_REG) % 0x14;
+            int ch = (addr - A_LEDC_HSCH0_CONF0_REG) / 0x14;
+            if (off == 0x08) r = s->duty_raw[ch];
+            else if (off == 0x10) r = s->duty_raw[ch] >> 4;
+        }
+        break;
     }
     return r;
 }
@@ -137,6 +146,7 @@ static void esp32_ledc_write(void *opaque, hwaddr addr,
     case A_LEDC_LSCH6_DUTY_REG:
     case A_LEDC_LSCH7_DUTY_REG:{
         int ledn = (addr - A_LEDC_HSCH0_DUTY_REG) / 0x14;
+        s->duty_raw[ledn] = value;
         led_set_intensity(&s->led[ledn], esp32_ledc_get_percent(s, value, ledn));
         qemu_set_irq(s->ledc_sync[0], (0x5000 | (ledn << 8) | led_get_intensity(&s->led[ledn])));
         }break;
diff --git a/hw/misc/esp32_sens.c b/hw/misc/esp32_sens.c
