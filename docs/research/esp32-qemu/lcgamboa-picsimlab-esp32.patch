--- a/hw/misc/esp32_sens.c
+++ b/hw/misc/esp32_sens.c
@@ -95,6 +95,15 @@ static const MemoryRegionOps esp32_sens_ops = {
     .endianness = DEVICE_LITTLE_ENDIAN,
 };
 
+/* IdeBlock: let an external process (qtest set_irq_in) drive ADC inputs.
+ * n = ADC channel index as used by ADC_values (ADC1 ch0-7 -> 0-7, ADC2 ch0-9 -> 8-17),
+ * level = raw 12-bit value. */
+static void esp32_sens_set_adc(void *opaque, int n, int level)
+{
+    Esp32SensState *s = ESP32_SENS(opaque);
+    s->ADC_values[n] = level;
+}
+
 static void esp32_sens_init(Object *obj)
 {
     Esp32SensState *s = ESP32_SENS(obj);
@@ -108,6 +117,7 @@ static void esp32_sens_init(Object *obj)
     memset(s->ADC_values, 0, sizeof(s->ADC_values));
     s->channel1 = 0;
     s->channel2 = 0;
+    qdev_init_gpio_in_named(DEVICE(obj), esp32_sens_set_adc, "esp32_adc_in", 32);
 }
 
 
